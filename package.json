{
  "name": "onml",
  "version": "2.2.0",
  "description": "JSONML Library",
  "main": "index.js",
  "scripts": {
    "test": "eslint *.js && nyc mocha",
    "bundle": "esbuild index.js --bundle --format=iife --global-name=onml --external:stream --outfile=build/onml.js",
    "prepublish": "npm run test && mkdir -p build && npm run bundle"
  },
  "files": [
    "build/onml.js",
    "*.js"
  ],
  "unpkg": "build/onml.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drom/onml.git"
  },
  "keywords": [
    "jsonml",
    "xml",
    "html",
    "svg"
  ],
  "author": "Aliaksei Chapyzhenka",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/drom/onml/issues"
  },
  "homepage": "https://github.com/drom/onml#readme",
  "devDependencies": {
    "@drom/eslint-config": "^1.0.0",
    "chai": "^4.3",
    "esbuild": "^0.25",
    "eslint": "^9",
    "mocha": "^10.2",
    "nyc": "^15.0.0"
  },
  "dependencies": {
    "sax": "^1.2.1"
  }
}
